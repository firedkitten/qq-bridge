# 部署脚本要在 Linux 上直接跑：强制 LF。
# 否则 Windows 上（core.autocrlf=true）检出成 CRLF，scp 到服务器后 bash 会报
#   /usr/bin/env: ‘bash\r’: No such file or directory
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf

# Windows 侧启动器保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf
